<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dominio canónico. esungatoencerrado.com apunta al mismo docroot y servía una
  # copia idéntica del sitio con HTTP 200: dos sitios iguales, sin redirect ni
  # canonical, repartiéndose la autoridad de búsqueda. Este 301 los consolida en
  # universo.gatoencerrado.org. Cuando esungatoencerrado.com pase a ser la
  # boletería de temporada, esta regla se retira.
  RewriteCond %{HTTP_HOST} ^(www\.)?esungatoencerrado\.com$ [NC]
  RewriteRule ^(.*)$ https://universo.gatoencerrado.org/$1 [R=301,L]

  # Servir artículos prerendered: /blog/slug → /blog/slug.html
  RewriteCond %{REQUEST_URI} ^/blog/[^/]+$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Permitir acceso directo a archivos y directorios
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Enrutamiento SPA
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # HTML sin caché (el navegador siempre trae la versión más reciente)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Assets estáticos (js/css/img) cacheables en navegador/CDN
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=604800, s-maxage=604800"
  </If>
</IfModule>
