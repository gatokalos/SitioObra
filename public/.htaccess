<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # esungatoencerrado.com es el dominio de la obra de teatro. Comparte docroot con
  # universo.gatoencerrado.org, así que los dos sitios se separan aquí.
  #
  # 1) La raíz sirve la página de la obra (obra.html) — hoy, la despedida
  #    "Decirnos adiós" (Carlos, 11 sep 2026). Reescritura interna, no redirect:
  #    la URL se queda en esungatoencerrado.com y Google la indexa como la obra,
  #    con canonical propio. Es lo que reemplaza el snippet viejo que Google
  #    guardaba de este dominio. Si vuelve una temporada, la boletería va aquí.
  RewriteCond %{HTTP_HOST} ^(www\.)?esungatoencerrado\.com$ [NC]
  RewriteRule ^$ obra.html [L]

  # 2) Todo lo demás en ese dominio sigue al universo con 301 (antes era la regla
  #    completa, commit 80b7949c): los enlaces viejos no se rompen y la autoridad
  #    de búsqueda del proyecto no se reparte. obra.html se excluye para que la
  #    reescritura de arriba no rebote aquí.
  RewriteCond %{HTTP_HOST} ^(www\.)?esungatoencerrado\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/obra\.html$
  RewriteRule ^(.*)$ https://universo.gatoencerrado.org/$1 [R=301,L]

  # Servir artículos prerendered: /blog/slug → /blog/slug.html
  RewriteCond %{REQUEST_URI} ^/blog/[^/]+$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Permitir acceso directo a archivos y directorios
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Enrutamiento SPA
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # HTML sin caché (el navegador siempre trae la versión más reciente)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Assets estáticos (js/css/img) cacheables en navegador/CDN
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=604800, s-maxage=604800"
  </If>
</IfModule>
